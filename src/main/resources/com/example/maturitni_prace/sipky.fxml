<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.maturitni_prace.SipkyController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" />
         </padding>
         <Button onAction="#onBack" text="← Menu" />
         <Label fx:id="titleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Šipky" />
      </HBox>
   </top>
   <center>
      <StackPane BorderPane.alignment="CENTER">

         <VBox fx:id="setupBox" maxWidth="500.0" spacing="10.0" StackPane.alignment="TOP_CENTER">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <HBox spacing="10.0">
               <TextField fx:id="nameField" onAction="#onAddPlayer" promptText="Jméno hráče" />
               <Button onAction="#onAddPlayer" text="Přidat" />
               <Button onAction="#onRemovePlayer" text="Odebrat vybraného" />
            </HBox>
            <ListView fx:id="playerList" prefHeight="200.0" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Label text="Hra na:" />
               <ComboBox fx:id="modeBox" />
            </HBox>
            <Button onAction="#onStart" style="-fx-font-size: 16px;" text="Začít hru" />
         </VBox>

         <BorderPane fx:id="gameBox" visible="false">
            <center>
               <TableView fx:id="table" fixedCellSize="40.0" style="-fx-font-size: 16px;">
                  <columns>
                     <TableColumn fx:id="colName" prefWidth="200.0" sortable="false" text="Hráč" />
                     <TableColumn fx:id="colRemaining" prefWidth="100.0" sortable="false" text="Zbývá" />
                     <TableColumn fx:id="colLast" prefWidth="120.0" sortable="false" text="Poslední kolo" />
                     <TableColumn fx:id="colAvg" prefWidth="120.0" sortable="false" text="Průměr/kolo" />
                     <TableColumn fx:id="colTurns" prefWidth="60.0" sortable="false" text="Kol" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>
            </center>
            <bottom>
               <VBox spacing="10.0" BorderPane.alignment="CENTER">
                  <padding>
                     <Insets top="15.0" />
                  </padding>
                  <Label fx:id="currentLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Na řadě:" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <TextField fx:id="scoreField" onAction="#onSubmit" prefWidth="200.0" promptText="Body za kolo (0–180)" />
                     <Button defaultButton="true" onAction="#onSubmit" text="Potvrdit" />
                     <Button onAction="#onUndo" text="↶ Zpět" />
                     <Button onAction="#onNewGame" text="Nová hra" />
                  </HBox>
                  <Label fx:id="infoLabel" style="-fx-text-fill: #b00020;" />
               </VBox>
            </bottom>
         </BorderPane>
      </StackPane>
   </center>
</BorderPane>
